# --- Application ---
NODE_ENV=production
TICKET_APP_NAME="Duton Ticket API"
TICKET_HOST=127.0.0.1
TICKET_PORT=8001
TICKET_DEBUG=false

# --- Database ---
# Replace with your production MongoDB connection string
NEW_DB_URL=mongodb://username:password@localhost:27017/duton
TICKET_DB_NAME=duton

# --- Security ---
# Critical: Generate a strong random secret for production
JWT_SECRET=
CALIBRATION_API_KEY=
CORS_ORIGIN=https://your-frontend-domain.com
TICKET_ASSIGNMENT_LOG_FILE=data/ticket-assignment-log.xlsx

# --- External APIs ---
FLOROSENSE_BASE_URL=
FLOROSENSE_API_KEY=
SENDGRID_API_KEY_ID=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=ticketcenter@florosense.com
SENDGRID_FROM_NAME="Ticket Center"

# SMTP (Brevo relay) - used for all outgoing emails
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=alerts@florosense.com
SMTP_FROM_NAME="Alert Notifications"
